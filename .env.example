# Copy to .env for local development. On Railway set these in the Variables tab.

# PostgreSQL (Railway sets this automatically when you add the Postgres plugin and reference it).
# Leave unset locally to use SQLite.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Required in production. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# Password for the first 'admin' account (only used the first time the database is created)
# ADMIN_PASSWORD=choose-a-strong-one

# Persistent folder for uploads, PDF archive and backups. On Railway attach a Volume and this is picked up
# automatically via RAILWAY_VOLUME_MOUNT_PATH; set DATA_DIR yourself only if you use another path.
# DATA_DIR=/data
